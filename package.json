{
  "name": "ndosi-playwright-profile-upload",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "npx playwright install && node scripts/decode-profile.js",
    "test": "npx playwright test",
    "report:allure": "allure generate allure-results --clean --output allure-report",
    "test:ci": "npx playwright test --reporter=html --output=playwright-report && npx playwright show-report playwright-report || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "playwright": "^1.63.0",
    "typescript": "^5.2.2"
  }
}
