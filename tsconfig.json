{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "types": ["@playwright/test", "node"],
    "outDir": "dist"
  },
  "include": ["src", "playwright.config.ts", "*.ts"]
}
